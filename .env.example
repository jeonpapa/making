# 이 파일을 .env.local 로 복사해 값을 채운다.
# Supabase 값이 비어 있으면 메모리 모드(로컬 테스트용, 서버 재시작 시 데이터 사라짐)로 동작한다.

# Supabase 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 운영자/진행자 로그인 PIN. 숫자 4자리보다 8자 이상 문구를 권장.
ADMIN_PIN=
# 세션 쿠키 서명용 임의 문자열 (32자 이상). `openssl rand -hex 32`
ADMIN_SESSION_SECRET=
